# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Exclude random heavy checkpoint dumps, but allow bundled release weights
*.tar.zst
*.7z
*.zip
*.bin

# Allow weights folder
!weights/*.pt
!weights/*.pth
!weights/*.json

# Datasets and Media Recordings
*.mp4
*.avi
*.mkv
*.jpg
*.png
!assets/*.png
!assets/*.jpg
!results/**/*.png
!results/**/*.jpg

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Output Logs
runs/
logs/
*.log
